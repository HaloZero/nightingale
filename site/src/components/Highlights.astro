---
const flagship = [
  {
    title: "Playback queue",
    description:
      "Build the set list as people choose songs, see what’s next, remove requests, or clear the queue when plans change.",
  },
  {
    title: "Session mode",
    description:
      "Keep karaoke playing in a dedicated window or browser tab while the main menu stays free for live queue management.",
  },
  {
    title: "Your playback layout",
    description:
      "Place lyrics where they work best and scale lyrics and the pitch graph independently with a live preview.",
  },
];

const alsoNew = [
  {
    title: "Faster library management",
    description:
      "Run analysis, metadata refreshes, realignment, and cache actions across the current filtered song list.",
  },
  {
    title: "Multi-level song sorting",
    description:
      "Sort the compact table by multiple columns with clear priorities that stay saved between sessions.",
  },
  {
    title: "Better microphone setup",
    description:
      "Test microphone recording and playback in Settings, with ASIO support available on Windows.",
  },
];
---

<section id="highlights">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">Latest release</span>
        <h2 class="section-title">What&apos;s new in v1.2.0</h2>
      </div>
      <a href="/docs/" class="docs-link">
        See full docs
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    <div class="flagship-row">
      {
        flagship.map((item) => (
          <article class="highlight-card flagship">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))
      }
    </div>

    <div class="dense-row">
      {
        alsoNew.map((item) => (
          <article class="highlight-card dense">
            <h4>{item.title}</h4>
            <p>{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .flagship-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 16px;
  }

  .dense-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .highlight-card {
    background: var(--surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    transition: transform 0.25s ease, border-color 0.25s ease,
      background 0.25s ease;
  }

  .highlight-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    background: var(--surface-hover);
  }

  .highlight-card.flagship {
    padding: 24px;
    position: relative;
    overflow: hidden;
  }

  .highlight-card.flagship::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      #4a6bf7 22%,
      #6d8bff 50%,
      #59c0e8 78%,
      transparent 100%
    );
    opacity: 0.85;
  }

  .highlight-card.dense {
    padding: 16px 18px;
  }

  .highlight-card h3 {
    margin: 0 0 10px;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .highlight-card h4 {
    margin: 0 0 6px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .highlight-card.flagship p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .highlight-card.dense p {
    margin: 0;
    font-size: 0.78rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 720px) {
    .flagship-row {
      grid-template-columns: 1fr;
    }

    .dense-row {
      grid-template-columns: 1fr;
    }
  }
</style>
