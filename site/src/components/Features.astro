      {
        icon: "📁",
        title: "Folder library",
        description:
          "Point at any folder and Nightingale scans the supported audio, video, and UltraStar files inside.",
      },
      {
        icon: "🟠",
        title: "Plex",
        description:
          "Select music libraries on a local or remote Plex Media Server. Hosted discovery and direct LAN URL + token connection are both supported.",
      },
      {
        icon: "🎬",
        title: "Jellyfin",
        description:
          "Play straight from your Jellyfin library. Songs cache locally on first play so karaoke runs the same as a folder library.",
      },
      {
        icon: "💿",
        title: "Navidrome",
        description:
          "Same idea for Navidrome (audio only). Login details are kept encrypted on disk.",
      },
      {
        icon: "🌐",
        title: "Self-hosted web mode",
        description:
          "Run Nightingale on a Linux box on your home network. Open it from any browser at <hostname>.local — one install script handles the rest.",
      },
      {
        icon: "🧭",
        title: "Song browser",
        description:
          "Switch between table and grid views, sort by multiple columns, and run bulk actions across any filtered song list.",
      },
      {
        icon: "📋",
        title: "Playback queue",
        description:
          "Build and manage the set list while people choose songs, with a clear next-up view and per-song controls.",
      },
      {
        icon: "🗂️",
        title: "Flexible storage",
        description:
          "Choose a main data folder, then split cache, models, videos, and vendor tools into separate folders from Settings.",
      },
      {
        icon: "📦",
        title: "Single binary",
        description:
