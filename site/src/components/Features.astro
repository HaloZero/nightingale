---

<section id="features">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">Everything included</span>
        <h2 class="section-title">Built for the whole set list</h2>
        <p class="section-sub">
          From where your music lives to how it sounds on the mic — every step
          of the karaoke pipeline is handled in one app.
        </p>
      </div>
      <a href="/docs/" class="docs-link">
        Explore docs
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    <div class="groups">
      {
        groups.map((group) => (
          <div class="group">
            <div class="group-header">
              <h3 class="group-title">{group.heading}</h3>
              <p class="group-desc">{group.description}</p>
            </div>
            <div class="features-grid">
              {group.items.map((f) => (
                <div class="feature-card">
                  <h4>
                    <span class="icon">{f.icon}</span> {f.title}
                  </h4>
                  <p>{f.description}</p>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .groups {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .group-header {
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  .group-title {
    display: inline-block;
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0 0 8px;
    letter-spacing: -0.01em;
    background: var(--grad-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .group-desc {
    margin: 0;
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 760px;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 16px;
  }

  .feature-card {
    position: relative;
    background: var(--surface);
    border-radius: var(--radius-lg);
    padding: 24px 22px;
    border: 1px solid var(--border);
    overflow: hidden;
    transition: transform 0.25s ease, border-color 0.25s ease,
      background 0.25s ease;
  }

  .feature-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: var(--grad-brand);
    -webkit-mask: linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    background: var(--surface-hover);
  }

  .feature-card:hover::before {
    opacity: 0.55;
  }

  .feature-card h4 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 10px;
    display: flex;
    align-items: center;
    gap: 10px;
    letter-spacing: -0.01em;
  }

  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    font-size: 1.15rem;
    line-height: 1;
    flex-shrink: 0;
    background: var(--grad-brand-soft);
    border: 1px solid var(--border);
  }

  .feature-card p {
    font-size: 0.87rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }


</style>
