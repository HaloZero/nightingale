{
  "name": "nightingale-site",
  "type": "module",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pnpm build:docs",
    "build:docs": "mdbook build docs && cp -r docs/book dist/docs",
    "preview": "pnpm build && astro preview",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name=nightingale"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.1",
    "astro": "^5.7.0"
  },
  "devDependencies": {
    "wrangler": "^4.122.0"
  }
}
